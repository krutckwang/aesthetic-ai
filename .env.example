# Copy this file to .env and fill in values. Never commit .env to git.

# HuggingFace Hub — model weight storage
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_REPO_ID=your-username/aesthetic-ai-checkpoints

# Database — use SQLite path for dev, PostgreSQL URL for production
DATABASE_URL=sqlite:////mnt/block/aesthetic-ai/staging.db
# DATABASE_URL=postgresql://user:password@localhost:5432/aesthetic_ai

# Kaggle API — place kaggle.json at ~/.kaggle/kaggle.json instead if preferred
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000

# Oracle block volume mount path
STORAGE_BASE_PATH=/mnt/block/aesthetic-ai

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
